# default: big-monitor-left
profile {
    output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0 scale 1.0
    output eDP-1 enable mode 1920x1080@165Hz position 1920,0 scale 1.2
}

profile big-monitor-right {
    output HDMI-A-1 enable mode 1920x1080@60Hz position 1600,0 scale 1.0
    output eDP-1 enable mode 1920x1080@165Hz position 0,0 scale 1.2
}

profile laptop-only {
    output eDP-1 enable mode 1920x1080@165Hz position 0,0 scale 1.0
}

profile small-monitor-left {
    output HDMI-A-1 enable mode 1600x900@60Hz position 0,0 scale 1.0
    output eDP-1 enable mode 1920x1080@165Hz position 1600,0 scale 1.0
}
